{
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "System": "Error",
                "Microsoft": "Error",
                "Microsoft.Hosting.Lifetime": "Error",
                "Microsoft.AspNetCore.Hosting.Diagnostics": "Error",
                "Microsoft.AspNetCore.StaticFiles.StaticFileMiddleware": "Error"
            }
        },
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "C:/SaipherApl/Logs/DotNetWithAngular", // Caminho onde será salvo o arquivo de log
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u}] ({Version}) {Message:lj}{NewLine}{Exception}",
                    "rollingInterval": "Hour", // Pode ser Hour, Minute, Day, Month, Year
                    "retainedFileCountLimit": null, // Quando igual a null, não limita a quantidade de arquivos
                    "retainedFileTimeLimit": "30.00:00:00", // dias.horas:minutos:segundos
                    "rollOnFileSizeLimit": true,
                    "fileSizeLimitBytes": 100000000 //100MB
                }
            }
        ]
    },
    "AllowedHosts": "*",
